name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Prepare web files
        run: |
          mkdir www
          cp -r index.html sw.js manifest.webmanifest 404.html sounds.json sounds icon-*.png www/
      - run: npm install
      - run: npx cap add android
      - name: Microphone permission
        run: sed -i 's#<application#<uses-permission android:name="android.permission.RECORD_AUDIO" /><application#' android/app/src/main/AndroidManifest.xml
      - name: App icon
        run: |
          rm -rf android/app/src/main/res/mipmap-anydpi-v26
          for d in android/app/src/main/res/mipmap-*; do for n in ic_launcher ic_launcher_round; do cp icon-192.png $d/$n.png; done; done
      - run: npx cap sync android
      - name: Build
        working-directory: android
        run: ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: little-world-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
